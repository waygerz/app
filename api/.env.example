# Local Docker Compose settings. Copy to api/.env (gitignored) and fill in:
#   cp .env.example .env
# Every service reads this file (env_file: .env); compose adds per-service
# SERVICE_NAME / DB_SCHEMA / DATABASE_URL itself. Prod does NOT use this file —
# ECS task definitions set the env and pull secrets from SSM (/waygerz/*).

# ---- Postgres (compose builds DATABASE_URL from these) ------------------------
POSTGRES_USER=waygerz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=waygerz

# ---- Shared secrets (identical across services) -------------------------------
# auth mints JWTs and every service verifies them with JWT_SECRET_KEY; internal
# /internal/* calls carry INTERNAL_TOKEN. Any long random string works locally:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
INTERNAL_TOKEN=change-me
SECRET_KEY=change-me
# Leave as development locally; "production" makes services refuse dev secrets.
APP_ENV=development

# ---- Cookies / CORS (local runs over plain http) --------------------------------
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000

# ---- SMS / OTP --------------------------------------------------------------------
# "log" writes OTP codes to the notifications log instead of texting them.
SMS_PROVIDER=log
# Only needed with SMS_PROVIDER=twilio (and for the twilio webhook service):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550000000

# ---- Sports data (ingestor) ---------------------------------------------------------
# ESPN needs no key. Without the keys below, odds come from ESPN only and RTS
# stays in mock mode.
SPORTS_API_MOCK=true
# SPORTS_API_KEY=
# ODDS_API_KEY=
# ODDS_MONTHLY_CREDITS=500
# ODDS_RESET_DAY=0

# ---- Media (S3) --------------------------------------------------------------------
# Mocked (no AWS calls) whenever APP_ENV != production.
# MEDIA_MOCK=true
# AWS_S3_BUCKET=waygerz
# AWS_REGION=us-east-1

# ---- Push ------------------------------------------------------------------------------
# PUSH_PROVIDER=log
